	"overrides": {
		"ws": {
			"5.2.0": "5.2.4",
			"6.0.0": "6.2.3",
			"7.0.0": "7.5.10",
			"8.16.0": "8.17.1",
			"^8.17.1": "^8.17.1"
		}
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
