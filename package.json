{
	"name": "2xleap",
	"version": "1.0.0",
	"description": "",
	"main": "dist/main.js",
	"repository": "git@github.com:Isabella/2xLeap.git",
	"author": "Lewdcario <isabellafj97@gmail.com>",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "rimraf ./dist && swc src -d dist -D --strip-leading-paths --copy-files",
		"run": "dotenv -- node .",
		"start": "yarn build && yarn run run",
		"start:dev": "yarn run start",
		"start:debug": "yarn run start:dev --debug --watch",
		"start:prod": "node dist/main",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
		"seed": "yarn build && dotenv -- node dist/test-utils/seed.js",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "yarn test --watch",
		"test:cov": "yarn test --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "yarn test --config ./test/jest-e2e.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@apollo/client": "^3.10.8",
		"@apollo/server": "^4.10.4",
		"@as-integrations/fastify": "^2.1.1",
		"@fastify/static": "^7.0.4",
		"@nestjs/apollo": "^12.1.0",
		"@nestjs/cache-manager": "^2.2.0",
		"@nestjs/cli": "^10.3.0",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.3",
		"@nestjs/core": "^10.0.0",
		"@nestjs/graphql": "^12.1.1",
		"@nestjs/platform-fastify": "^10.3.1",
		"@nestjs/throttler": "^5.1.1",
		"@nestjs/typeorm": "^10.0.1",
		"@prisma/client": "^5.16.1",
		"@swc/cli": "^0.4.0",
		"cache-manager": "^5.4.0",
		"cross-fetch": "^4.0.0",
		"dotenv": "^16.4.5",
		"dotenv-cli": "^7.4.2",
		"execa": "5.1.1",
		"fastify": "^4.26.0",
		"graphql": "^16.9.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"sqlite": "^5.1.1",
		"sqlite3": "^5.1.7",
		"typeorm": "^0.3.20",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@stylistic/eslint-plugin-ts": "^2.3.0",
		"@swc/core": "^1.6.6",
		"@swc/jest": "^0.2.36",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^7.14.1",
		"@typescript-eslint/parser": "^7.14.1",
		"cross-env": "^7.0.3",
		"eslint": "^9.6.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^9.0.11",
		"jest": "^29.5.0",
		"lint-staged": "^15.2.7",
		"prettier": "^3.0.0",
		"prisma": "^5.16.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"supertest-graphql": "^1.1.4",
		"ts-morph": "^23.0.0",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.ts": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{js,json,css,scss,md}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=20.9"
	},
	"resolutions": {
		"wrap-ansi": "7.0.0"
	},
	"overrides": {
		"ws": {
			"5.2.0": "5.2.4",
			"6.0.0": "6.2.3",
			"7.0.0": "7.5.10",
			"8.16.0": "8.17.1"
		}
	}
}
